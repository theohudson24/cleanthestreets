datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  user
  admin
}

enum IssueType {
  pothole
  damaged_road
  debris
  signage
  other
}

enum ReportStatus {
  reported
  in_progress
  fixed
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  avatarUrl    String?
  bio          String?
  location     String?
  role         UserRole @default(user)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  reports      Report[]
}

model Report {
  id          Int          @id @default(autoincrement())
  userId      String?
  user        User?        @relation(fields: [userId], references: [id])
  issueType   IssueType
  description String?
  latitude    Float
  longitude   Float
  status      ReportStatus @default(reported)
  severity    Int          @default(1)
  address     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  images      ReportImage[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([issueType, createdAt])
}

model ReportImage {
  id        Int      @id @default(autoincrement())
  reportId  Int
  url       String
  createdAt DateTime @default(now())
  report    Report   @relation(fields: [reportId], references: [id])
}
